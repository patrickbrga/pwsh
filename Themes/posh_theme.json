{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "shell_integration": true,
  "final_space": true,
  "patch_pwsh_bleed": true,
  "async": true,
  "version": 3,
  "palette": {
    "white": "#FFFFFF",
    "light_yellow": "#F1FA8C",
    "blue": "#0078d4",
    "light_blue": "#43CCEA",
    "green": "#6CA35E",
    "light_green": "#42E66C",
    "light_orange": "#fc983b",
    "light_gray": "#9c9c9c",
    "purple": "#d82dfa",
    "red": "#ff0000"
  },
  "transient_prompt": {
    "background": "transparent",
    "foreground": "p:white",
    "template": "\udb82\udca9 "
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "diamond",
          "leading_diamond": "\u256d\u2500[ ",
          "foreground": "p:white",
          "template": "<b>{{ .Path }}</b>",
          "options": {
            "folder_icon": "<p:white>\udb81\udf70 </>",
            "folder_separator_icon": "<p:light_yellow>\ue0b1 </>",
            "home_icon": "\udb80\udedc ",
            "style": "agnoster_short"
          }
        },
        {
          "type": "git",
          "style": "diamond",
          "foreground": "p:light_orange",
          "foreground_templates": [],
          "template": "{{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }}{{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} <p:light_yellow> {{ .Working.String }}</>{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} <p:light_green> {{ .Staging.String }}</>{{ end }}{{ if gt .StashCount 0 }} <p:light_gray> {{ .StashCount }}</>{{ end }}",
          "options": {
            "fetch_status": true,
            "fetch_push_status": true,
            "fetch_upstream_icon": true,
            "branch_icon": " \udb81\ude2c ",
            "branch_ahead_icon": " \udb80\udc5d",
            "branch_behind_icon": " \udb80\udc45",
            "branch_identical_icon": " ☁️ ",
            "branch_gone_icon": " ⛈️",
            "github_icon": "<p:light_gray> \uF408 </>",
            "gitlab_icon": "<p:light_orange> \uF296 </>",
            "bitbucket_icon": "<p:blue> \uF171 </>",
            "azure_devops_icon": "<p:blue> \uEBE8 </>"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "overflow": "break",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:light_yellow",
          "template": "\uf252 {{ .FormattedMs }} ",
          "options": {
            "threshold": 10
          }
        },
        {
          "type": "kubectl",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#000000",
          "background": "#ebcc34",
          "template": " ﴱ {{.Context}}{{if .Namespace}} :: {{.Namespace}}{{end}} ",
          "options": {
            "context_aliases": {
              "arn:aws:eks:eu-west-1:1234567890:cluster/posh": "posh"
            }
          }
        },
        {
          "type": "time",
          "style": "diamond",
          "foreground": "p:white",
          "template": "\udb82\udd54 {{ .CurrentDate | date .Format }}",
          "options": {
            "time_format": "15:04:05"
          }
        },
        {
          "type": "text",
          "style": "diamond",
          "invert_powerline": true,
          "template": " ]\u2500\u256e"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "diamond",
          "leading_diamond": "\u2570\u2500",
          "template": "["
        },
        {
          "type": "status",
          "style": "diamond",
          "template": "{{ if .Error }} <p:red>\uea87</> {{ end }}",
          "options": {
            "always_enabled": true
          }
        },
        {
          "type": "az",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#000000",
          "background": "#9ec3f0",
          "template": "  {{ .EnvironmentName }}",
          "options": {
            "source": "pwsh"
          }
        },
        {
          "type": "dotnet",
          "style": "powerline",
          "foreground": "p:purple",
          "template": "\ue77f {{ .Full }}",
          "options": {
            "display_mode": "context"
          }
        },
        {
          "type": "node",
          "style": "powerline",
          "foreground": "p:green",
          "template": "\udb80\udf99 {{ .Full }}"
        },
        {
          "type": "angular",
          "style": "powerline",
          "foreground": "p:red",
          "template": "  {{ .Full }} "
        },
        {
          "type": "react",
          "style": "powerline",
          "foreground": "p:light_blue",
          "template": "  {{ .Full }} "
        },
        {
          "type": "docker",
          "style": "powerline",
          "foreground": "p:blue",
          "template": " \udb82\udc68 {{ .Context }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "spotify",
          "style": "diamond",
          "foreground": "p:light_green",
          "template": "{{ .Icon }}{{ if ne .Status \"stopped\" }}{{ .Artist }} - {{ .Track }}{{ end }} \udb81\udcc7",
          "options": {
            "playing_icon": "\udb81\udc0a ",
            "paused_icon": "\udb80\udfe4 ",
            "stopped_icon": "\udb81\udcdb "
          }
        },
        {
          "type": "text",
          "style": "diamond",
          "invert_powerline": true,
          "template": " ]\u2500\u256f"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "p:white",
          "style": "plain",
          "template": "\uf4b5",
          "type": "text"
        }
      ]
    }
  ]
}